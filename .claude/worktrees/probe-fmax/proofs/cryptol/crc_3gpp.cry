// 3GPP TS36.212 §5.1.1 CRC polynomials, expressed in Cryptol.
//
// The Cryptol functions below are the canonical bit-level specifications;
// the SAW driver `crc_3gpp.saw` then proves that the C transliteration
// in `calculate_crc_bits.c` produces bit-identical output for fixed
// input length A.
//
// Polynomial encoding. Each polynomial is a bit vector of length P+1
// where index 0 is the coefficient of x^P (the leading 1 of a CRC
// generator), index P is the constant term, and the bits in between
// follow MSB-first. This matches `get_3gpp_crc_polynomial.m`'s output.
//
// Bit-order convention. Input `a` and output `p` are MSB-first
// (matching MATLAB's row-vector index ordering). The CRC operation is
// `a(x) * x^P mod g(x)` over GF(2), where `a(x) = sum_k a[k] * x^(A-1-k)`.
// Equivalent algorithmic form: feed `a ++ zero_P` through an LFSR.

module crc_3gpp where

// Generic LFSR-form CRC. `crc poly input` processes each bit of
// `input ++ zero` of total length `A + P` through a linear feedback
// shift register of width `P`, where `P + 1` is the polynomial length.
// Returns the final P-bit state, which is the CRC.
crc : {a, p} (fin a, fin p, p >= 1) =>
      [p+1] -> [a] -> [p]
crc poly input = states ! 0
  where
    polyTail = drop`{1} poly : [p]
    extended = (input # (zero : [p])) : [a + p]
    states = [zero : [p]] # [ step s b | s <- states | b <- extended ]
    step s b = if s @ 0
               then ((drop`{1} s # [b]) ^ polyTail)
               else (drop`{1} s # [b])

// ------------------------------------------------------------------
// The four 3GPP polynomials (TS36.212 §5.1.1).
// ------------------------------------------------------------------

// g_CRC24A(D) = D^24 + D^23 + D^18 + D^17 + D^14 + D^11 + D^10
//             + D^7  + D^6  + D^5  + D^4  + D^3  + D     + 1
// Bits  [D^24, D^23, ..., D, 1]:
crc24A_poly : [25]
crc24A_poly = 0b1100001100100110011111011

// g_CRC24B(D) = D^24 + D^23 + D^6 + D^5 + D + 1.
crc24B_poly : [25]
crc24B_poly = 0b1100000000000000001100011

// g_CRC16(D) = D^16 + D^12 + D^5 + 1.
crc16_poly : [17]
crc16_poly = 0b10001000000100001

// g_CRC8(D) = D^8 + D^7 + D^4 + D^3 + D + 1.
crc8_poly : [9]
crc8_poly = 0b110011011

// ------------------------------------------------------------------
// Polynomial-specific CRC functions, instantiated for fixed input
// length A. SAW's llvm_verify operates on fixed-size symbolic inputs,
// so each (polynomial, A) pair needs its own monomorphised binding.
// The polymorphic `crc` infers `a` from the input length and `p` from
// the polynomial length, so no explicit type signature is needed here.
// ------------------------------------------------------------------

crc24A_A16 a = crc crc24A_poly (a : [16])
crc24B_A16 a = crc crc24B_poly (a : [16])
crc16_A16  a = crc crc16_poly  (a : [16])
crc8_A16   a = crc crc8_poly   (a : [16])

// ------------------------------------------------------------------
// Byte-array shims for the SAW LLVM proof. The C transliteration
// represents bits as a `uint8_t[]` array (one byte per bit, with each
// byte ∈ {0, 1}). Cryptol's natural representation is a `[A]` bit
// vector, so the shim below takes the LSB of each byte to convert.
// The output is similarly returned as `[P][8]` so it matches the C
// output buffer's type element-for-element (`out_p[i] = bit i`).
// ------------------------------------------------------------------

bits_from_bytes : {n} (fin n) => [n][8] -> [n]
bits_from_bytes bs = [ b ! 0 | b <- bs ]

bytes_from_bits : {n} (fin n) => [n] -> [n][8]
bytes_from_bits bs = [ zext [b] | b <- bs ]

crc24A_A16_bytes : [16][8] -> [24][8]
crc24A_A16_bytes a = bytes_from_bits (crc24A_A16 (bits_from_bytes a))

crc24B_A16_bytes : [16][8] -> [24][8]
crc24B_A16_bytes a = bytes_from_bits (crc24B_A16 (bits_from_bytes a))

crc16_A16_bytes : [16][8] -> [16][8]
crc16_A16_bytes a = bytes_from_bits (crc16_A16 (bits_from_bytes a))

crc8_A16_bytes : [16][8] -> [8][8]
crc8_A16_bytes a = bytes_from_bits (crc8_A16 (bits_from_bytes a))

// Self-checks: encode-and-check that a single 1 bit at the high end of
// `a` produces a non-zero CRC for the standard polynomials.
property crc24A_one_bit_nonzero =
  crc24A_A16 0x8000 != 0

property crc8_zero_input_zero_output =
  crc8_A16 0x0000 == 0
